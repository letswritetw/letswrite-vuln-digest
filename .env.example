# 複製成 .env 再填入。.env 已列入 .gitignore，不要提交或分享。
# 修改後執行 docker compose up -d --force-recreate n8n，n8n 啟動時會自動建立 Credential。

# 必填：Gemini API Key
GEMINI_API_KEY=

# 選用：Telegram Bot Token（另需在 config.json 設定 telegramEnabled 與 telegramChatId）
TELEGRAM_BOT_TOKEN=

# 選用：儀表板綁定位址，預設只開放本機
# DASHBOARD_BIND=127.0.0.1
